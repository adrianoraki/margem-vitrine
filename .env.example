# Copie para apps/web/.env.local (site) ou exporte no shell (coletor).
# NUNCA commite valores reais. Em produção: Vercel (site) e Secrets do GitHub Actions (jobs).

# ── Site (apps/web) — públicas: chegam ao navegador ─────────────────────────────
# URL do projeto Supabase (Settings → API). Ex.: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave PÚBLICA (anon/publishable). O site recusa a service role aqui e para de subir.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública do site, para metadados e links absolutos. Ex.: https://margem.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Site (apps/web) — só servidor ───────────────────────────────────────────────
# Sal do hash de IP no limite de taxa. Qualquer string aleatória longa (openssl rand -hex 32).
RATE_LIMIT_SALT=

# ── Jobs no GitHub Actions (coletor PNCP, keep-alive) — só servidor ─────────────
# Mesma URL do projeto. Secret do repositório: SUPABASE_URL.
SUPABASE_URL=
# Service role: IGNORA a RLS. Só em Secret do GitHub Actions e nas Edge Functions.
# Nunca na Vercel, nunca com prefixo NEXT_PUBLIC_, nunca no app.
SUPABASE_SERVICE_ROLE_KEY=

# Coletor PNCP (opcionais)
# UFs separadas por vírgula. Padrão: PB
COLETOR_UFS=PB
# Códigos de modalidade PNCP. Padrão: 6 (pregão eletrônico), 8 (dispensa)
COLETOR_MODALIDADES=6,8
# Janela de publicação em dias (1–30). Padrão: 2
COLETOR_DIAS=2
# Contratações encerradas revisitadas por execução, atrás do preço homologado. Padrão: 40
COLETOR_REVISITAR=40
# 1 = não grava nada, só lista (rodar local sem Supabase). Padrão: 0
COLETOR_SECO=0

# ── Deploy (Secrets do GitHub Actions) ──────────────────────────────────────────
# Token da Vercel (Account Settings → Tokens), e ids de .vercel/project.json após `vercel link`.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ── Edge Function certificado-upload (Supabase → Edge Functions → Secrets) ──────
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY o Supabase injeta sozinho.
# Origem permitida no CORS. Ex.: https://margem.app
SITE_URL=
